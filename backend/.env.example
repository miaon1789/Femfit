PORT=3000

# Supabase —— 三个值都在 Project Settings → API 里
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key                 # 用于验证用户 JWT（authMiddleware）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 服务端绕过 RLS，切勿暴露给前端

# AI 服务（二选一，由 AI_PROVIDER 决定）
AI_PROVIDER=claude
CLAUDE_API_KEY=your-claude-api-key
# OPENAI_API_KEY=your-openai-api-key

# CORS 允许的前端来源（部署后改成线上前端域名）
FRONTEND_URL=http://localhost:5173
